FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    // left boundary where fluid flows in
    leftWall
    {
        type            zeroGradient;
    }

    // right boundary where fluid flows out (PRESSURE)
    rightWall
    {
        type            fixedValue;
        value           uniform 0;
    }

    // walls (lower, upper boundary and obstacle)
    fixedWalls
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}


